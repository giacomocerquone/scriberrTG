{
  "name": "scriberrtg",
  "version": "1.0.0",
  "description": "Telegram bot that forwards audio to Scriberr for transcription",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "eventsource": "^4.0.0",
    "form-data": "^4.0.4",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^24.3.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
