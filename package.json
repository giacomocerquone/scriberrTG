{
  "name": "scriberrtg",
  "version": "0.1.0",
  "description": "Telegram bot that forwards audio to Scriberr for transcription",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "start": "node dist/index.js",
    "release": "sh -c 'npm version \"${1:-patch}\" && git push --follow-tags' _"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "eventsource": "^4.0.0",
    "form-data": "^4.0.4",
    "node-telegram-bot-api": "^0.66.0",
    "p-queue": "^8.1.1",
    "sanitize-filename": "^1.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^24.3.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
