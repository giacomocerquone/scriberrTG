TELEGRAM_BOT_TOKEN=
SCRIBERR_API_TOKEN=
# In Docker: use the Scriberr container name on the shared network, not localhost.
SCRIBERR_HOST_URL=http://scriberr:8080
# Comma-separated Telegram user IDs; if set, only these users can use the bot (unset = anyone).
# TELEGRAM_ALLOWED_USER_IDS=123456789
# Optional:
# SSE_TIMEOUT_MS=600000
# PROFILE_CACHE_TTL_MS=600000
